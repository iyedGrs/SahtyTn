{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User authentication and management service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start:dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec ts-node ./src/index.ts",
    "docker-build:dev": "docker build -t user-service-image-dev:0.1 -f Dockerfile.dev .",
    "docker-run:dev": "docker run -it -p 3000:3000 --name user-service-container -v ./:/app -v my-node-modules:/app/node_modules user-service-image-dev:0.1",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "authentication",
    "user",
    "microservice"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.0",
    "mongoose": "^8.6.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "body-parser": "^1.20.3",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.12",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/cors": "^2.8.13",
    "@types/body-parser": "^1.19.2",
    "@types/nodemailer": "^6.4.15",
    "typescript": "^5.8.3",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.1"
  }
}
