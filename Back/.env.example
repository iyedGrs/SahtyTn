# Database Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/sahtydb?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (for OTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Service Ports
API_GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
MESSAGING_SERVICE_PORT=5002
APPOINTMENT_SERVICE_PORT=5003
CONSULTATION_SERVICE_PORT=5004
DASHBOARD_SERVICE_PORT=5005
MEDICAL_RECORDS_SERVICE_PORT=5006
NOTIFICATIONS_SERVICE_PORT=5007
PAYMENT_SERVICE_PORT=5008
PRESCRIPTIONS_SERVICE_PORT=5009

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://user-service:3000
MESSAGING_SERVICE_URL=http://messaging-service:3001
APPOINTMENT_SERVICE_URL=http://appointment-service:3002
CONSULTATION_SERVICE_URL=http://localhost:5004
DASHBOARD_SERVICE_URL=http://localhost:5005
MEDICAL_RECORDS_SERVICE_URL=http://localhost:5006
NOTIFICATIONS_SERVICE_URL=http://localhost:5007
PAYMENT_SERVICE_URL=http://localhost:5008
PRESCRIPTIONS_SERVICE_URL=http://localhost:5009

# External Services
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SENDGRID_API_KEY=your-sendgrid-api-key

# Environment
NODE_ENV=development

# Frontend URL used by backend CORS (set this to your VM domain/IP in cloud)
FRONTEND_URL=http://localhost:5173
