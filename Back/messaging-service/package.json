{
  "name": "messaging-service",
  "version": "1.0.0",
  "description": "Messaging and contact management service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon index.js",
    "start:dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec ts-node ./src/index.ts",
    "docker-build:dev": "docker build -t messaging-service-image-dev:0.1 -f Dockerfile.dev .",
    "docker-run:dev": "docker run -it -p 3001:3001 --name messaging-service-container -v ./:/app -v my-node-modules:/app/node_modules messaging-service-image-dev:0.1",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "messaging",
    "contact",
    "microservice"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.6.0",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.12",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
